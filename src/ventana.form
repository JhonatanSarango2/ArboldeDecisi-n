<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="ventana">
  <grid id="panelPrincipal" binding="panel1" default-binding="true" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints><xy x="20" y="20" width="850" height="550"/></constraints>
    <properties/>
    <border type="none"/>
    <children>
      <tabbedpane id="tabs" binding="tabbedPane1">
        <constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"><preferred-size width="200" height="200"/></grid></constraints>
        <properties/>
        <border type="none"/>
        <children>
          <grid id="prediccionPanel" binding="prediccion" layout-manager="GridLayoutManager" row-count="4" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="10" left="10" bottom="10" right="10"/>
            <constraints><tabbedpane title="Predicción"/></constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="tituloPred" class="javax.swing.JLabel">
                <constraints><grid row="0" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/></constraints>
                <properties><font size="18" style="1"/><text value="Árbol de Decisión"/></properties>
              </component>
              <component id="lblPregunta" class="javax.swing.JLabel" binding="lblPregunta">
                <constraints><grid row="1" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/></constraints>
                <properties><font size="16" style="1"/><text value="Pregunta actual"/></properties>
              </component>
              <scrollpane id="scrollPrediccion">
                <constraints><grid row="2" column="0" row-span="1" col-span="3" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"><preferred-size width="-1" height="300"/></grid></constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="textAreaPrediccion" class="javax.swing.JTextArea" binding="textAreaPrediccion">
                    <constraints/>
                    <properties><editable value="false"/><lineWrap value="true"/><wrapStyleWord value="true"/></properties>
                  </component>
                </children>
              </scrollpane>
              <component id="siButton" class="javax.swing.JButton" binding="siButton">
                <constraints><grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints>
                <properties><text value="Sí"/></properties>
              </component>
              <component id="noButton" class="javax.swing.JButton" binding="noButton">
                <constraints><grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints>
                <properties><text value="No"/></properties>
              </component>
              <component id="reiniciarButton" class="javax.swing.JButton" binding="reiniciarButton">
                <constraints><grid row="3" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints>
                <properties><text value="Reiniciar"/></properties>
              </component>
            </children>
          </grid>
          <grid id="recorridosPanel" binding="recorridos" layout-manager="GridLayoutManager" row-count="3" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="10" left="10" bottom="10" right="10"/>
            <constraints><tabbedpane title="Recorridos"/></constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="preordenButton" class="javax.swing.JButton" binding="preordenButton">
                <constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints>
                <properties><text value="Preorden"/></properties>
              </component>
              <component id="inordenButton" class="javax.swing.JButton" binding="inordenButton">
                <constraints><grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints>
                <properties><text value="Inorden"/></properties>
              </component>
              <component id="postordenButton" class="javax.swing.JButton" binding="postordenButton">
                <constraints><grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints>
                <properties><text value="Postorden"/></properties>
              </component>
              <component id="nivelesButton" class="javax.swing.JButton" binding="nivelesButton">
                <constraints><grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints>
                <properties><text value="Niveles"/></properties>
              </component>
              <component id="lblRec" class="javax.swing.JLabel">
                <constraints><grid row="1" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints>
                <properties><text value="Resultado del recorrido:"/></properties>
              </component>
              <scrollpane id="scrollRecorridos">
                <constraints><grid row="2" column="0" row-span="1" col-span="4" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"><preferred-size width="-1" height="400"/></grid></constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="textAreaRecorridos" class="javax.swing.JTextArea" binding="textAreaRecorridos">
                    <constraints/>
                    <properties><editable value="false"/></properties>
                  </component>
                </children>
              </scrollpane>
            </children>
          </grid>
          <grid id="estructuraPanel" binding="estructura" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="10" left="10" bottom="10" right="10"/>
            <constraints><tabbedpane title="Estructura"/></constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="mostrarEstructuraButton" class="javax.swing.JButton" binding="mostrarEstructuraButton">
                <constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints>
                <properties><text value="Mostrar estructura"/></properties>
              </component>
              <component id="lblEst" class="javax.swing.JLabel">
                <constraints><grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints>
                <properties><text value="Explicación del árbol:"/></properties>
              </component>
              <scrollpane id="scrollEstructura">
                <constraints><grid row="2" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"><preferred-size width="-1" height="420"/></grid></constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="textAreaEstructura" class="javax.swing.JTextArea" binding="textAreaEstructura">
                    <constraints/>
                    <properties><editable value="false"/><lineWrap value="true"/><wrapStyleWord value="true"/></properties>
                  </component>
                </children>
              </scrollpane>
            </children>
          </grid>
        </children>
      </tabbedpane>
    </children>
  </grid>
</form>
